<Window x:Class="Library_Management_System_for_DAZSMA.LibrarianSignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Librarian Sign Up"
        Width="1920" Height="1080"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FF">
	<Window.Resources>
		<!-- Palette -->
		<Color x:Key="Primary600">#2731CF</Color>
		<Color x:Key="Primary700">#1E2AB6</Color>
		<Color x:Key="Primary800">#15218F</Color>
		<Color x:Key="Ink900Color">#0B0B10</Color>
		<Color x:Key="AppTitleColor">#0A094F</Color>
		<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}" />
		<SolidColorBrush x:Key="PrimaryBrushDark" Color="{StaticResource Primary700}" />
		<SolidColorBrush x:Key="TextBrush" Color="#0C0D10" />
		<SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
		<SolidColorBrush x:Key="FieldBgBrush" Color="#F5F7FF" />
		<SolidColorBrush x:Key="FieldBorderBrush" Color="#DCE1F5" />
		<SolidColorBrush x:Key="Ink900" Color="{StaticResource Ink900Color}" />
		<SolidColorBrush x:Key="AppTitleBrush" Color="{StaticResource AppTitleColor}" />
		<FontFamily x:Key="UiFont">Segoe UI</FontFamily>
		<FontFamily x:Key="HeadingFont">Georgia</FontFamily>

		<!-- Shared rounded border style for inputs -->
		<Style x:Key="RoundedBorder" TargetType="Border">
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
		</Style>

		<!-- TextBox with watermark -->
		<Style TargetType="TextBox">
			<Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
			<Setter Property="Padding" Value="14,10,14,10"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Grid>
							<Border Style="{StaticResource RoundedBorder}"/>
							<ScrollViewer x:Name="PART_ContentHost" Margin="8,4,8,4"/>
							<TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="14,10,14,10"
                                       IsHitTestVisible="False"
                                       FontFamily="{StaticResource UiFont}"
                                       Visibility="Collapsed"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="Text" Value="">
								<Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
							</Trigger>
							<Trigger Property="Text" Value="{x:Null}">
								<Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Primary action button -->
		<Style TargetType="Button">
			<Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
			<Setter Property="Padding" Value="16,12"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="{StaticResource PrimaryBrushDark}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="TextBlock" x:Key="LabelStyle">
			<Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
		</Style>
	</Window.Resources>

	<Grid>
		<!-- Left side: Form -->
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Width="580" Margin="50,0,0,0">
			<TextBlock Text="Librarian Sign Up"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,0,0,30"/>

			<StackPanel>
				<TextBlock Text="DAZSMA Library"
                           FontFamily="{StaticResource HeadingFont}"
                           FontWeight="Bold"
                           FontSize="36"
                           Foreground="{StaticResource AppTitleBrush}"
                           TextAlignment="Left"/>
				<TextBlock Text="Management System"
                           FontFamily="{StaticResource HeadingFont}"
                           FontWeight="Bold"
                           FontSize="36"
                           Foreground="{StaticResource AppTitleBrush}"
                           TextAlignment="Left"
                           Margin="0,0,0,30"/>
			</StackPanel>

			<TextBlock Text="Create new librarian account"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource Ink900}"
                       TextAlignment="Left"
                       Margin="0,0,0,10"/>

			<TextBlock Text="Please enter the required details"
                       FontSize="14"
                       Foreground="{StaticResource SubtleTextBrush}"
                       TextAlignment="Left"
                       Margin="0,0,0,30"/>

			<!-- Name field -->
			<TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
			<TextBox x:Name="NameBox"
                     Height="48"
                     Tag="juan de La Cruz"
                     Margin="0,0,0,20"
                     VerticalContentAlignment="Center"/>

			<!-- Email field -->
			<TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
			<TextBox x:Name="EmailBox"
                     Height="48"
                     Tag="juandelaCruz@gmail.com"
                     Margin="0,0,0,20"
                     VerticalContentAlignment="Center"/>

			<!-- Password field with reveal -->
			<TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
			<Grid Height="48" Margin="0,0,0,20">
				<Border Style="{StaticResource RoundedBorder}"/>

				<PasswordBox x:Name="PwdBox"
                             Margin="14,0,48,0"
                             FontSize="14"
                             FontFamily="{StaticResource UiFont}"
                             PasswordChanged="PwdBox_PasswordChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"/>

				<TextBox x:Name="PwdText"
                         Margin="14,0,48,0"
                         FontSize="14"
                         FontFamily="{StaticResource UiFont}"
                         Visibility="Collapsed"
                         TextChanged="PwdText_TextChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"/>

				<TextBlock x:Name="PwdPlaceholder"
                           Text="Juan de La Cruz"
                           Foreground="{StaticResource SubtleTextBrush}"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="14"
                           Margin="14,0,48,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>

				<ToggleButton x:Name="RevealToggle"
                              Width="36" Height="36"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              Margin="0,0,6,0"
                              Checked="RevealToggle_Checked"
                              Unchecked="RevealToggle_Unchecked"
                              Background="Transparent"
                              BorderThickness="0"
                              ToolTip="Show/Hide Password">
					<TextBlock x:Name="RevealIcon"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="{StaticResource SubtleTextBrush}"
                               Text="&#xE7B3;"/>
				</ToggleButton>
			</Grid>

			<!-- Sign up as admin link -->
			<TextBlock HorizontalAlignment="Center"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Margin="0,0,0,20">
				<Hyperlink Click="SignUpAsAdmin_Click">Sign up as admin instead</Hyperlink>
			</TextBlock>

			<!-- Sign Up button -->
			<Button Height="52"
                    Click="SignUp_Click"
                    Margin="0,0,0,15">
				<TextBlock Text="Sign Up" FontWeight="SemiBold" FontSize="16"/>
			</Button>

			<!-- Already have account link -->
			<TextBlock HorizontalAlignment="Center"
                       FontFamily="{StaticResource UiFont}"
                       FontSize="12"
                       Foreground="{StaticResource SubtleTextBrush}">
				<Run Text="already have an account? "/>
				<Hyperlink Click="BackToLogin_Click">
					<Run Text="Click Here" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
				</Hyperlink>
			</TextBlock>
		</StackPanel>

		<!-- Right side: School logo background -->
		<Rectangle Fill="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" Width="750">
			<Rectangle.OpacityMask>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
					<GradientStop Color="Transparent" Offset="0"/>
					<GradientStop Color="Black" Offset="0.3"/>
				</LinearGradientBrush>
			</Rectangle.OpacityMask>
		</Rectangle>

		<TextBlock Text="DON ANTONIO DE ZUZUARREGUI, SR. MEMORIAL ACADEMY, INCORPORATED"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,80,50"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   TextAlignment="Center"
                   Width="200">
			<TextBlock.Inlines>
				<Run Text="DON ANTONIO DE ZUZUARREGUI, SR." FontSize="14"/>
				<LineBreak/>
				<Run Text="MEMORIAL ACADEMY, INCORPORATED" FontSize="14"/>
			</TextBlock.Inlines>
		</TextBlock>
	</Grid>
</Window>