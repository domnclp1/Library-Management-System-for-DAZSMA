<Application x:Class="Library_Management_System_for_DAZSMA.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Library_Management_System_for_DAZSMA"
             xmlns:vm="clr-namespace:Library_Management_System_for_DAZSMA.ViewModels"
             xmlns:views="clr-namespace:Library_Management_System_for_DAZSMA.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- DataTemplates map ViewModel types to Views -->
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
