<Window x:Class="Library_Management_System_for_DAZSMA.LibrarianSignUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Librarian Sign Up"
        Width="1920" Height="1080"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FF">
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="Primary600">#2731CF</Color>
        <Color x:Key="Primary700">#1E2AB6</Color>
        <Color x:Key="Primary800">#15218F</Color>
        <Color x:Key="Ink900Color">#0B0B10</Color>
        <Color x:Key="AppTitleColor">#0A094F</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}" />
        <SolidColorBrush x:Key="PrimaryBrushDark" Color="{StaticResource Primary700}" />
        <SolidColorBrush x:Key="TextBrush" Color="#0C0D10" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="FieldBgBrush" Color="#F5F7FF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#DCE1F5" />
        <SolidColorBrush x:Key="Ink900" Color="{StaticResource Ink900Color}" />
        <SolidColorBrush x:Key="AppTitleBrush" Color="{StaticResource AppTitleColor}" />
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <FontFamily x:Key="HeadingFont">Georgia</FontFamily>

        <!-- Shared rounded border style for inputs -->
        <Style x:Key="RoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        </Style>

        <!-- TextBox with watermark -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="16,12,16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Style="{StaticResource RoundedBorder}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0,0,0,0"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="16,12,16,12"
                                       IsHitTestVisible="False"
                                       FontFamily="{StaticResource UiFont}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrushDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Gradient Brush for Hero Section -->
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary800}" Offset="0"/>
            <GradientStop Color="{StaticResource Primary600}" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <!-- add Grid columns to mirror MainWindow -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <!-- Left side: Form content -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Width="600" Margin="120,40,0,40">
                <!-- App Title -->
                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="DAZSMA Library" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="40" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Left"/>
                    <TextBlock Text="Management System" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="40" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Left"/>
                </StackPanel>

                <!-- Main heading -->
                <TextBlock Text="Create new librarian account"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource Ink900}"
                           TextAlignment="Left"
                           Margin="0,0,0,12"/>

                <!-- Subtitle -->
                <TextBlock Text="Please enter the required details"
                           FontSize="14"
                           Foreground="{StaticResource SubtleTextBrush}"
                           TextAlignment="Left"
                           Margin="0,0,0,40"/>

                <!-- Name field -->
                <TextBlock Text="Name" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="NameBox"
                         Height="52"
                         Tag="juan de La Cruz"
                         Margin="0,0,0,24"
                         VerticalContentAlignment="Center"/>

                <!-- Email field -->
                <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="EmailBox"
                         Height="52"
                         Tag="juandelaCruz@gmail.com"
                         Margin="0,0,0,24"
                         VerticalContentAlignment="Center"/>

                <!-- Password field with reveal -->
                <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                <Grid Height="52" Margin="0,0,0,24">
                    <Border Style="{StaticResource RoundedBorder}"/>

                    <PasswordBox x:Name="PwdBox" 
                                 Margin="16,0,48,0" 
                                 FontSize="14"
                                 FontFamily="{StaticResource UiFont}"
                                 PasswordChanged="PwdBox_PasswordChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 Padding="0,12,0,12"/>

                    <TextBox x:Name="PwdText" 
                             Margin="16,0,48,0" 
                             FontSize="14"
                             FontFamily="{StaticResource UiFont}"
                             Visibility="Collapsed"
                             TextChanged="PwdText_TextChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalContentAlignment="Center"
                             Padding="0,12,0,12"/>

                    <TextBlock x:Name="PwdPlaceholder"
                               Text="Juan de La Cruz"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="14"
                               Margin="16,0,48,0"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <ToggleButton x:Name="RevealToggle"
                                  Width="36" Height="36"
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Right"
                                  Margin="0,0,8,0"
                                  Checked="RevealToggle_Checked"
                                  Unchecked="RevealToggle_Unchecked"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ToolTip="Show/Hide Password">
                        <TextBlock x:Name="RevealIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="&#xE7B3;"/>
                    </ToggleButton>
                </Grid>

                <!-- Sign up as admin link -->
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SubtleTextBrush}"
                           Margin="0,0,0,20">
                    <Hyperlink Click="SignUpAsAdmin_Click">Sign up as admin instead</Hyperlink>
                </TextBlock>

                <!-- Sign Up button -->
                <Button Height="52" 
                        Click="SignUp_Click"
                        Margin="0,0,0,15">
                    <TextBlock Text="Sign Up" FontWeight="SemiBold" FontSize="16"/>
                </Button>

                <!-- Already have account link -->
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" 
                           FontSize="12" 
                           Foreground="{StaticResource SubtleTextBrush}">
                    <Run Text="already have an account? "/>
                    <Hyperlink Click="BackToLogin_Click">
                        <Run Text="Click Here" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Right side: Hero logo card copied from MainWindow (fills column, no fixed size) -->
        <Border Grid.Column="1"
                Margin="24"
                CornerRadius="18"
                Background="{StaticResource HeroGradient}">
            <Border.Effect>
                <DropShadowEffect Color="#4C1A1A1A" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Image Source="pack://application:,,,/Assets/dazsma_logo.png"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Width="400"
                       Height="398"
                       Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</Window>