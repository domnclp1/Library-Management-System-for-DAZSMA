<Window x:Class="Library_Management_System_for_DAZSMA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DAZSMA Library Management System"
        Width="1366" Height="768" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5FF">
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="Primary600">#2731CF</Color>
        <Color x:Key="Primary700">#1E2AB6</Color>
        <Color x:Key="Primary800">#15218F</Color>
        <Color x:Key="Ink900Color">#0B0B10</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}" />
        <SolidColorBrush x:Key="PrimaryBrushDark" Color="{StaticResource Primary700}" />
        <SolidColorBrush x:Key="TextBrush" Color="#0C0D10" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="FieldBgBrush" Color="#F5F7FF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#DCE1F5" />
        <SolidColorBrush x:Key="Ink900" Color="{StaticResource Ink900Color}" />
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <FontFamily x:Key="HeadingFont">Georgia</FontFamily>

        <!-- Shared rounded border style for inputs -->
        <Style x:Key="RoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        </Style>

        <!-- TextBox with watermark via Tag -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Style="{StaticResource RoundedBorder}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,4"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="14,10"
                                       IsHitTestVisible="False"
                                       FontFamily="{StaticResource UiFont}"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox style -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Primary action button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrushDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton style -->
        <Style x:Key="EyeToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label style -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
        </Style>

        <!-- Gradient -->
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary800}" Offset="0"/>
            <GradientStop Color="{StaticResource Primary600}" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Form -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Margin="60,32,40,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Title -->
                <StackPanel Grid.Row="0" Margin="40,0,40,10">
                    <TextBlock Text="DAZSMA Library" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"
                               FontSize="36" Foreground="{StaticResource Ink900}" TextAlignment="Center"/>
                    <TextBlock Text="Management System" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold"
                               FontSize="36" Foreground="{StaticResource Ink900}" TextAlignment="Center"/>
                </StackPanel>

                <!-- Welcome -->
                <TextBlock Grid.Row="2" Text="Welcome Back, Librarian!"
                           FontFamily="{StaticResource HeadingFont}" FontSize="36" FontWeight="Black"
                           Foreground="{StaticResource Ink900}" Margin="20,10,20,0" TextAlignment="Center"/>

                <TextBlock Grid.Row="4" Text="Please enter your details to log in securely"
                           FontFamily="{StaticResource UiFont}" FontSize="16"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="20,0" TextAlignment="Center"/>

                <!-- Email -->
                <TextBlock Grid.Row="6" Text="Email" Style="{StaticResource LabelStyle}" Margin="20,16,20,8"/>
                <TextBox Grid.Row="6" Margin="20,46,20,0" Height="44"
                         Tag="Please enter your email here"
                         Name="EmailBox"/>

                <!-- Password label + link -->
                <Grid Grid.Row="8" Margin="20,16,20,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}" FontFamily="{StaticResource UiFont}"
                               FontSize="12" FontWeight="SemiBold">
                        <Hyperlink Click="ForgotPassword_Click">Forgot the Password?</Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Password field with reveal -->
                <Grid Grid.Row="8" Margin="20,46,20,0" Height="44">
                    <Border Style="{StaticResource RoundedBorder}"/>
                    
                    <PasswordBox x:Name="PwdBox" Margin="14,10,44,10" 
                                 PasswordChanged="PwdBox_PasswordChanged"/>
                    
                    <TextBox x:Name="PwdText" Margin="14,10,44,10" Visibility="Collapsed"
                             TextChanged="PwdText_TextChanged"/>

                    <!-- Placeholder -->
                    <TextBlock x:Name="PwdPlaceholder"
                               Text="Please enter your password here"
                               Foreground="{StaticResource SubtleTextBrush}"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="14"
                               Margin="14,10,44,10"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="Visible"/>

                    <!-- Reveal toggle -->
                    <ToggleButton x:Name="RevealToggle"
                                  Style="{StaticResource EyeToggleButton}"
                                  Width="32" Height="32"
                                  VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Margin="0,0,6,0"
                                  Checked="RevealToggle_Checked"
                                  Unchecked="RevealToggle_Unchecked"
                                  ToolTip="Show/Hide Password">
                        <TextBlock x:Name="RevealIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   Text="&#xE7B3;"/>
                    </ToggleButton>
                </Grid>

                <!-- Admin link -->
                <TextBlock Grid.Row="10" Margin="20,10" HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="Log in as admin instead"/>

                <!-- Login button -->
                <Button Grid.Row="11" Margin="20,6,20,0" Height="48" Click="LoginButton_Click">
                    <TextBlock Text="Log In" FontWeight="SemiBold"/>
                </Button>

                <!-- Create account -->
                <TextBlock Grid.Row="11" Margin="20,58,20,0" HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}">
                    <Run Text="create new librarian account? "/>
                    <Run Text="Click Here" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </ScrollViewer>

        <!-- Right: Gradient card with logo -->
        <Border Grid.Column="1" Margin="24" CornerRadius="18" Background="{StaticResource HeroGradient}">
            <Border.Effect>
                <DropShadowEffect Color="#4C1A1A1A" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <Image Source="pack://application:,,,/Assets/dazsma_logo.png"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,40,60,0" Width="380" Height="380" Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>
