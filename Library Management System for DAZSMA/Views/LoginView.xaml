<UserControl x:Class="Library_Management_System_for_DAZSMA.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Library_Management_System_for_DAZSMA.ViewModels"
             xmlns:helpers="clr-namespace:Library_Management_System_for_DAZSMA.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: simplified login form (Librarian/Admin panels) -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="600" HorizontalAlignment="Center" Margin="40,60,40,60">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top title -->
                <StackPanel>
                    <TextBlock Text="DAZSMA Library" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="36" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Center"/>
                    <TextBlock Text="Management System" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="36" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,24,0,0">
                    <TextBlock Text="Login" FontFamily="{StaticResource HeadingFont}" FontSize="28" FontWeight="Black"/>
                    <TextBlock Text="Please enter your details to log in securely" FontFamily="{StaticResource UiFont}" FontSize="14" Foreground="{StaticResource SubtleTextBrush}"/>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                        <TextBox Height="48" VerticalContentAlignment="Center"
                                 Text="{Binding CurrentEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Password" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                        <Grid Height="48">
                            <Border Style="{StaticResource RoundedBorder}"/>
                            <PasswordBox x:Name="PwdBox"
                                         helpers:PasswordBoxHelper.BoundPassword="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="14,0,48,0" 
                                         FontSize="14"
                                         FontFamily="{StaticResource UiFont}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVisibilityInverse}}"/>

                            <TextBox x:Name="PwdText" 
                                     Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="14,0,48,0" 
                                     FontSize="14"
                                     FontFamily="{StaticResource UiFont}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVisibility}}"/>

                            <ToggleButton IsChecked="{Binding IsPasswordRevealed, Mode=TwoWay}"
                                          Width="36" Height="36"
                                          VerticalAlignment="Center" 
                                          HorizontalAlignment="Right"
                                          Margin="0,0,6,0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ToolTip="Show/Hide Password">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource SubtleTextBrush}"
                                           Text="{Binding IsPasswordRevealed, Converter={StaticResource EyeIconConverter}}"/>
                            </ToggleButton>
                        </Grid>

                        <Button Height="52" Margin="0,16,0,0" Command="{Binding LoginCommand}">
                            <TextBlock Text="Log In" FontWeight="SemiBold" FontSize="16"/>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Foreground="{StaticResource SubtleTextBrush}">create new account? </TextBlock>
                            <Button Command="{Binding CreateAccountCommand}" Style="{StaticResource TransparentButton}">
                                <TextBlock Text="Click Here" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>

                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Hyperlink Command="{Binding ForgotPasswordCommand}">Forgot the Password?</Hyperlink>
                        </TextBlock>

                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Hyperlink Command="{Binding SwitchRoleCommand}">{Binding SwitchRoleText}</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Right: Gradient card with logo (kept from MainWindow) -->
        <Border Grid.Column="1" Margin="24" CornerRadius="18" Background="{StaticResource HeroGradient}">
            <Border.Effect>
                <DropShadowEffect Color="#4C1A1A1A" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Image Source="pack://application:,,,/Assets/dazsma_logo.png"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Top" 
                       Width="400" 
                       Height="398"
                       Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
