<Window x:Class="Library_Management_System_for_DAZSMA.CreateNewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create New Password - DAZSMA Library Management System"
        Width="1920" Height="1080" 
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F5FF">
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="Primary600">#2731CF</Color>
        <Color x:Key="Primary700">#1E2AB6</Color>
        <Color x:Key="Primary800">#15218F</Color>
        <Color x:Key="Ink900Color">#0B0B10</Color>
        <Color x:Key="AppTitleColor">#0A094F</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary600}" />
        <SolidColorBrush x:Key="PrimaryBrushDark" Color="{StaticResource Primary700}" />
        <SolidColorBrush x:Key="TextBrush" Color="#0C0D10" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="FieldBgBrush" Color="#F5F7FF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#DCE1F5" />
        <SolidColorBrush x:Key="Ink900" Color="{StaticResource Ink900Color}" />
        <SolidColorBrush x:Key="AppTitleBrush" Color="{StaticResource AppTitleColor}" />
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <FontFamily x:Key="HeadingFont">Georgia</FontFamily>

        <!-- Shared rounded border style for inputs -->
        <Style x:Key="RoundedBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource FieldBgBrush}"/>
        </Style>

        <!-- TextBox with watermark via Tag -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Style="{StaticResource RoundedBorder}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,4,8,4"/>
                            <TextBlock x:Name="Watermark"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Margin="14,10,14,10"
                                       IsHitTestVisible="False"
                                       FontFamily="{StaticResource UiFont}"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox with simplified style (no triggers) -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,10,14,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Style="{StaticResource RoundedBorder}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,4,8,4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrushDark}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Ink900}"/>
        </Style>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource Primary800}" Offset="0"/>
            <GradientStop Color="{StaticResource Primary600}" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Create New Password Form -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="600" HorizontalAlignment="Center" Margin="40,100,40,100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Title (two lines) -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="DAZSMA Library" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="36" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Center"/>
                    <TextBlock Text="Management System" 
                               FontFamily="{StaticResource HeadingFont}" 
                               FontWeight="Bold"
                               FontSize="36" 
                               Foreground="{StaticResource AppTitleBrush}" 
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Create New Password Title -->
                <TextBlock Grid.Row="2" 
                           Text="Create New Password"
                           FontFamily="{StaticResource HeadingFont}" 
                           FontSize="32" 
                           FontWeight="Black"
                           Foreground="{StaticResource Ink900}" 
                           TextAlignment="Center"/>

                <TextBlock Grid.Row="4" 
                           Text="Create a new password for your account."
                           FontFamily="{StaticResource UiFont}" 
                           FontSize="14"
                           Foreground="{StaticResource SubtleTextBrush}" 
                           TextAlignment="Center"/>

                <!-- Password Label with "Log In Instead" link -->
                <Grid Grid.Row="6">
                    <TextBlock Text="New Password" 
                               Style="{StaticResource LabelStyle}"
                               HorizontalAlignment="Left"/>
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}" 
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12" 
                               FontWeight="SemiBold">
                        <Hyperlink Click="LogInInstead_Click">Log In Instead</Hyperlink>
                    </TextBlock>
                </Grid>

                <!-- Password Input -->
                <PasswordBox Grid.Row="8" 
                             Height="48"
                             Name="NewPasswordBox"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PasswordBox_PasswordChanged">
                    <PasswordBox.Tag>
                        <TextBlock Text="Enter your new password" 
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontFamily="{StaticResource UiFont}"/>
                    </PasswordBox.Tag>
                </PasswordBox>

                <!-- Retype Password Label -->
                <TextBlock Grid.Row="10" 
                           Text="Retype Password" 
                           Style="{StaticResource LabelStyle}"
                           Margin="0,20,0,0"/>

                <!-- Retype Password Input -->
                <PasswordBox Grid.Row="12" 
                             Height="48"
                             Name="RetypePasswordBox"
                             VerticalContentAlignment="Center"
                             PasswordChanged="PasswordBox_PasswordChanged">
                    <PasswordBox.Tag>
                        <TextBlock Text="Retype your new password" 
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   FontFamily="{StaticResource UiFont}"/>
                    </PasswordBox.Tag>
                </PasswordBox>

                <!-- Confirm Password Button -->
                <Button Grid.Row="14" 
                        Height="52" 
                        Click="ConfirmPassword_Click"
                        Name="ConfirmPasswordButton"
                        IsEnabled="False">
                    <TextBlock Text="Confirm Password" FontWeight="SemiBold" FontSize="16"/>
                </Button>

                <!-- Create Account Link -->
                <TextBlock Grid.Row="16" 
                           HorizontalAlignment="Center"
                           FontFamily="{StaticResource UiFont}" 
                           FontSize="12" 
                           Foreground="{StaticResource SubtleTextBrush}">
                    <Run Text="create an account instead? "/>
                    <Hyperlink Click="CreateAccount_Click">
                        <Run Text="Click here" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </ScrollViewer>

        <!-- Right: Gradient card with logo -->
        <Border Grid.Column="1" Margin="24" CornerRadius="18" Background="{StaticResource HeroGradient}">
            <Border.Effect>
                <DropShadowEffect Color="#4C1A1A1A" BlurRadius="24" ShadowDepth="0" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Image Source="pack://application:,,,/Assets/dazsma_logo.png"
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Top" 
                       Width="400" 
                       Height="398"
                       Stretch="Uniform"/>
            </Grid>
        </Border>
    </Grid>
</Window>