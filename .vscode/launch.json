{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (WPF)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Library Management System for DAZSMA/bin/Debug/net8.0-windows/Library Management System for DAZSMA.exe",
      "args": [],
      "cwd": "${workspaceFolder}/Library Management System for DAZSMA",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": true,
      "cwd": "c:/Users/ALLAN/Documents/GitHub/Library-Management-System-for-DAZSMA",
      "program": "c:/Users/ALLAN/Documents/GitHub/Library-Management-System-for-DAZSMA/build/Debug/outDebug",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}